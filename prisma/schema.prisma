generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity / directory
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  ownedProjects  Project[]       @relation("ProjectOwnerOrg")
  projectMembers ProjectMember[]
  roleAssignments UserRoleAssignment[]
  mailingGroups   MailingGroup[]
  hseEquipment    HseEquipment[]
  hseEmergencyContacts HseEmergencyContact[]
  fieldObservations    FieldObservation[]
  fieldIssues          FieldIssue[]
  fieldPunchItems      FieldPunchItem[]
  fieldItps            FieldItp[]
  fieldItpItems        FieldItpItem[]
  fieldTests           FieldTest[]

  @@index([name])
}

enum UserAccountType {
  FULL
  GUEST
}

/// HIDDEN users are excluded from ordinary Directory search results (still
/// real rows — never deleted); administrators can still see them. There is
/// no third "Shadow" state — this app has no concrete rule to distinguish
/// it from HIDDEN, so it was not invented.
enum DirectoryVisibility {
  VISIBLE
  HIDDEN
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String
  /// Best-effort split of `name` for existing records (backfilled once,
  /// non-destructively); captured directly on Create User/Guest going
  /// forward. `name` remains the canonical display field everywhere else.
  givenName      String?
  familyName     String?
  jobTitle       String?
  division       String?
  phone          String?
  address        String?
  visibility     DirectoryVisibility @default(VISIBLE)
  organizationId String
  isActive       Boolean         @default(true)
  /**
   * GUEST accounts represent an external correspondent added to a project's
   * Directory for mail purposes only — they are always created with
   * isActive = false so the existing login check blocks sign-in for them.
   */
  accountType    UserAccountType @default(FULL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id])
  sessions                 Session[]
  projectMembers           ProjectMember[]
  sentMail                 Mail[]                    @relation("MailSender")
  mailRecipients           MailRecipient[]
  savedSearches            SavedSearch[]
  documents                Document[]                @relation("DocumentCreatedBy")
  documentVersions         DocumentVersion[]         @relation("DocumentVersionUploadedBy")
  temporaryFiles           TemporaryFile[]           @relation("TemporaryFileUploadedBy")
  autoTexts                AutoText[]                @relation("AutoTextCreatedBy")
  signatures               Signature[]
  mailInlineImages         MailInlineImage[]         @relation("MailInlineImageUploadedBy")
  auditLogs                AuditLog[]
  mailTypeAttributeOptions MailTypeAttributeOption[]
  mailDocumentReferences   MailDocumentReference[]
  mailRelatedMails         MailRelatedMail[]
  printRequests            PrintRequest[]
  initiatedWorkflows       Workflow[]                @relation("WorkflowInitiatedBy")
  workflowStepReviews      WorkflowStepReviewer[]
  workflowTemplateSteps    WorkflowTemplateStepReviewer[]
  workflowTemplatesCreated WorkflowTemplate[]
  workflowOutcomeOptionsCreated WorkflowOutcomeOption[]
  workflowEvents           WorkflowEvent[]           @relation("WorkflowEventActor")
  roleAssignments          UserRoleAssignment[]
  roleAssignmentsGranted   UserRoleAssignment[]      @relation("UserRoleAssignmentGrantedBy")
  mailingGroupsCreated     MailingGroup[]            @relation("MailingGroupCreatedBy")
  mailingGroupMemberships MailingGroupMember[]
  hseAttachmentsUploaded       HseAttachment[]
  hseObservationsReported      HseObservation[]        @relation("HseObservationReportedBy")
  hseIncidentsReported         HseIncident[]           @relation("HseIncidentReportedBy")
  hseIncidentPersonLinks       HseIncidentPerson[]
  hseNearMissesReported        HseNearMiss[]           @relation("HseNearMissReportedBy")
  hseNearMissesAssigned        HseNearMiss[]           @relation("HseNearMissAssignedTo")
  hseHazardsResponsible        HseHazard[]             @relation("HseHazardResponsible")
  hseHazardsCreated            HseHazard[]             @relation("HseHazardCreatedBy")
  hseControlsOwned             HseControl[]
  hseRiskAssessmentsResponsible HseRiskAssessment[]     @relation("HseRiskAssessmentResponsible")
  hseRiskAssessmentsCreated    HseRiskAssessment[]      @relation("HseRiskAssessmentCreatedBy")
  hseInspectionTemplatesCreated HseInspectionTemplate[]
  hseInspectionsPerformed      HseInspection[]
  hseActionsAssigned           HseCorrectiveAction[]    @relation("HseActionAssignedTo")
  hseActionsVerified           HseCorrectiveAction[]    @relation("HseActionVerifiedBy")
  hseActionsCreated            HseCorrectiveAction[]    @relation("HseActionCreatedBy")
  hsePermitsRequested          HsePermit[]
  hsePermitApprovals           HsePermitApproval[]
  hseEquipmentResponsible      HseEquipment[]          @relation("HseEquipmentResponsible")
  hseEquipmentCreated          HseEquipment[]          @relation("HseEquipmentCreatedBy")
  hseEquipmentInspectionsPerformed HseEquipmentInspection[] @relation("HseEquipmentInspectionInspector")
  hseEmergencyContactsCreated   HseEmergencyContact[]    @relation("HseEmergencyContactCreatedBy")
  hseEmergencyProceduresReviewed HseEmergencyProcedure[] @relation("HseEmergencyProcedureReviewedBy")
  hseEmergencyProceduresCreated HseEmergencyProcedure[]  @relation("HseEmergencyProcedureCreatedBy")
  hseEmergencyEventsReported    HseEmergencyEvent[]      @relation("HseEmergencyEventReportedBy")
  hseEmergencyDrillsCoordinated HseEmergencyDrill[]      @relation("HseEmergencyDrillCoordinator")
  hseEmergencyDrillsCreated     HseEmergencyDrill[]      @relation("HseEmergencyDrillCreatedBy")
  hseEmergencyDrillAttendances  HseEmergencyDrillAttendee[] @relation("HseEmergencyDrillAttendeeUser")
  fieldAttachmentsUploaded      FieldAttachment[]
  fieldDocumentReferencesCreated FieldDocumentReference[]
  fieldPhotosCreated            FieldPhoto[] @relation("FieldPhotoCreatedBy")
  fieldComments                 FieldComment[]
  fieldObservationsResponsible  FieldObservation[] @relation("FieldObservationResponsible")
  fieldObservationsCreated      FieldObservation[] @relation("FieldObservationCreatedBy")
  fieldObservationsClosed       FieldObservation[] @relation("FieldObservationClosedBy")
  fieldInspectionTemplatesCreated FieldInspectionTemplate[]
  fieldInspectionsAssigned     FieldInspection[] @relation("FieldInspectionAssignee")
  fieldInspectionsInspected    FieldInspection[] @relation("FieldInspectionInspector")
  fieldInspectionsCreated      FieldInspection[] @relation("FieldInspectionCreatedBy")
  fieldIssuesResponsible       FieldIssue[] @relation("FieldIssueResponsible")
  fieldIssuesVerified          FieldIssue[] @relation("FieldIssueVerifiedBy")
  fieldIssuesCreated           FieldIssue[] @relation("FieldIssueCreatedBy")
  fieldIssuesClosed            FieldIssue[] @relation("FieldIssueClosedBy")
  fieldPunchlistsOwned         FieldPunchlist[] @relation("FieldPunchlistOwner")
  fieldPunchlistsCreated       FieldPunchlist[] @relation("FieldPunchlistCreatedBy")
  fieldPunchItemsResponsible   FieldPunchItem[] @relation("FieldPunchItemResponsible")
  fieldPunchItemsCreated       FieldPunchItem[] @relation("FieldPunchItemCreatedBy")
  fieldPunchItemsClosed        FieldPunchItem[] @relation("FieldPunchItemClosedBy")
  fieldItpsCreated             FieldItp[]
  fieldItpItemsDecided         FieldItpItem[] @relation("FieldItpItemDecidedBy")
  fieldTestsTested             FieldTest[] @relation("FieldTestTestedBy")
  fieldTestsCreated            FieldTest[] @relation("FieldTestCreatedBy")
  fieldSiteWalksStarted        FieldSiteWalk[] @relation("FieldSiteWalkStartedBy")
  managementSystemDocumentsCreated ManagementSystemDocument[] @relation("ManagementSystemDocumentCreatedBy")
  managementSystemDocumentsUpdated ManagementSystemDocument[] @relation("ManagementSystemDocumentUpdatedBy")
  managementSystemDocumentVersionsUploaded ManagementSystemDocumentVersion[] @relation("ManagementSystemDocumentVersionUploadedBy")
  managementSystemCertificatesUploaded ManagementSystemCertificate[] @relation("ManagementSystemCertificateUploadedBy")

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id         String   @id @default(cuid())
  name       String
  shortName  String
  code       String?
  /**
   * Client/employer name shown on the mail letterhead, e.g. "Ministry of Culture, Sports and Youth".
   */
  clientName String?
  /**
   * Project location shown on the mail letterhead, e.g. "Sultanate of Oman, Muscat".
   */
  location   String?
  ownerOrgId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownerOrg                Organization?            @relation("ProjectOwnerOrg", fields: [ownerOrgId], references: [id])
  members                 ProjectMember[]
  mailTypes               MailType[]
  mails                   Mail[]
  folders                 Folder[]
  documentTypes           DocumentType[]
  documents               Document[]
  temporaryFiles          TemporaryFile[]
  autoTexts               AutoText[]
  mailInlineImages        MailInlineImage[]
  savedSearches           SavedSearch[]
  auditLogs               AuditLog[]
  printRequests           PrintRequest[]
  workflows               Workflow[]
  workflowTemplates       WorkflowTemplate[]
  workflowOutcomeOptions  WorkflowOutcomeOption[]
  documentMetadataOptions DocumentMetadataOption[]
  roleAssignments         UserRoleAssignment[]
  mailingGroups           MailingGroup[]
  hseObservations         HseObservation[]
  hseIncidents            HseIncident[]
  hseNearMisses           HseNearMiss[]
  hseHazards              HseHazard[]
  hseRiskAssessments      HseRiskAssessment[]
  hseInspectionTemplates  HseInspectionTemplate[]
  hseInspections          HseInspection[]
  hseCorrectiveActions    HseCorrectiveAction[]
  hsePermits              HsePermit[]
  hseEquipment            HseEquipment[]
  hseEquipmentInspections HseEquipmentInspection[]
  hseEmergencyContacts    HseEmergencyContact[]
  hseEmergencyProcedures  HseEmergencyProcedure[]
  hseEmergencyEvents      HseEmergencyEvent[]
  hseEmergencyDrills      HseEmergencyDrill[]
  fieldAreas              FieldArea[]
  fieldPhotos             FieldPhoto[]
  fieldLookups            FieldLookup[]
  fieldObservations       FieldObservation[]
  fieldInspectionTemplates FieldInspectionTemplate[]
  fieldInspections        FieldInspection[]
  fieldIssues             FieldIssue[]
  fieldPunchlists         FieldPunchlist[]
  fieldPunchItems         FieldPunchItem[]
  fieldItps               FieldItp[]
  fieldTests              FieldTest[]
  fieldSiteWalks          FieldSiteWalk[]
  managementSystemDocuments    ManagementSystemDocument[]
  managementSystemCertificates ManagementSystemCertificate[]

  @@index([ownerOrgId])
}

// ---------------------------------------------------------------------------
// Management System Documents — the company's controlled ISO 9001/14001/45001
// document register (Quality/Environment/Health & Safety procedures, forms,
// work instructions). Deliberately separate from the operational Aconex-style
// Document register above: different lifecycle (no review workflow), scoped
// to its own distinct controlled-document library per the explicit brief
// ("Do NOT merge Management System Documents with the operational EDMS
// Document Register").
// ---------------------------------------------------------------------------

enum ManagementSystemCategory {
  QUALITY
  ENVIRONMENT
  HSE
}

model ManagementSystemDocument {
  id               String                   @id @default(cuid())
  projectId        String
  documentNo       String
  title            String
  managementSystem ManagementSystemCategory
  documentType     String
  currentRevision  String                   @default("01")
  documentDate     DateTime?
  author           String?
  documentOwner    String?
  createdById      String
  updatedById      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  project   Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                              @relation("ManagementSystemDocumentCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                             @relation("ManagementSystemDocumentUpdatedBy", fields: [updatedById], references: [id])
  versions  ManagementSystemDocumentVersion[]

  @@unique([projectId, documentNo])
  @@index([projectId, managementSystem])
}

model ManagementSystemDocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  revision     String
  versionNo    Int
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  checksum     String
  isCurrent    Boolean  @default(true)
  notes        String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  document   ManagementSystemDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User                     @relation("ManagementSystemDocumentVersionUploadedBy", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNo])
  @@index([documentId])
}

/// One real certificate record per management system (Quality/Environment/HSE)
/// — the actual uploaded ISO PDF is the source of truth; never regenerated.
model ManagementSystemCertificate {
  id               String                   @id @default(cuid())
  projectId        String
  managementSystem ManagementSystemCategory
  isoStandard      String
  title            String
  fileName         String
  storedPath       String
  mimeType         String
  sizeBytes        Int
  checksum         String
  /// Printed on the real certificate file itself — never invented; left
  /// null until someone transcribes it from that specific certificate.
  registrationNo   String?
  certifyingBody   String?
  scope            String?
  issueDate        DateTime?
  validUntil       DateTime?
  expiryDate       DateTime?
  uploadedById     String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ManagementSystemCertificateUploadedBy", fields: [uploadedById], references: [id])

  @@unique([projectId, managementSystem])
  @@index([projectId])
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

model ProjectMember {
  id             String      @id @default(cuid())
  projectId      String
  userId         String
  organizationId String
  role           ProjectRole @default(MEMBER)
  createdAt      DateTime    @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Mail
// ---------------------------------------------------------------------------

model MailType {
  id                 String  @id @default(cuid())
  projectId          String
  name               String
  attribute1Label    String?
  attribute2Label    String?
  requiresAttribute1 Boolean @default(false)
  requiresAttribute2 Boolean @default(false)

  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mails            Mail[]
  attributeOptions MailTypeAttributeOption[]

  @@unique([projectId, name])
}

/**
 * A selectable value for a MailType's attribute1/attribute2 slot (slot 1 or
 * 2), configured on the fly from the Register Incoming Mail "Select
 * Attributes" modal rather than through a separate admin screen.
 */
model MailTypeAttributeOption {
  id          String   @id @default(cuid())
  mailTypeId  String
  slot        Int
  value       String
  createdById String
  createdAt   DateTime @default(now())

  mailType  MailType @relation(fields: [mailTypeId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([mailTypeId, slot, value])
  @@index([mailTypeId, slot])
}

enum MailStatus {
  DRAFT
  SENT
}

enum MailDirection {
  OUTGOING
  INCOMING
}

enum MailResponseType {
  RESPOND_BY
  APPROVE_BY
  SUBMIT_COMMENTS_BY
  REVISE_RESUBMIT_BY
  SUBMIT_QUOTATION_BY
  FABRICATE_AND_DELIVER_BY
  TENDER_DUE_BY
  ACKNOWLEDGE_BY
  ACTION_BY
}

/**
 * Why a document is being issued via a Transmittal — distinct from
 * MailResponseType (which is about what response is due back), since a
 * transmittal always has a reason for issue even when no response is
 * required at all (e.g. "For Information").
 */
enum MailReasonForIssue {
  FOR_APPROVAL
  FOR_INFORMATION
  FOR_CONSTRUCTION
  FOR_REVIEW_COMMENT
  FOR_TENDER
  FOR_RECORD
  AS_BUILT
  SUPERSEDED
}

// Business/workflow status shown in the mail register (distinct from
// MailStatus above, which tracks the internal draft-vs-sent lifecycle).
enum MailWorkflowStatus {
  NA
  OUTSTANDING
  OVERDUE
  RESPONDED
  NO_ACTION_REQUIRED
  CLOSED_OUT
}

model Mail {
  id               String              @id @default(cuid())
  projectId        String
  mailNumber       String
  referenceNumber  String?
  typeId           String
  subject          String
  /**
   * Sanitized rich-text HTML — canonical, rendered representation of the message body.
   */
  messageHtml      String              @default("")
  /**
   * Plain-text derivative of messageHtml, kept in sync on every save — used for search, accessibility, and fallback rendering.
   */
  messageText      String              @default("")
  attribute1       String?
  attribute2       String?
  responseRequired Boolean             @default(false)
  responseDueDate  DateTime?
  responseType     MailResponseType?
  reasonForIssue   MailReasonForIssue?
  status           MailStatus          @default(DRAFT)
  workflowStatus   MailWorkflowStatus  @default(NA)
  /**
   * Whether this record was created by our organization sending correspondence
   * out (OUTGOING, the default — New Mail) or by registering correspondence
   * that was actually received from an external/project party (INCOMING —
   * Register Incoming Mail). senderId always reflects the true author of the
   * message in both cases; this field only distinguishes who initiated the
   * record in our system.
   */
  direction        MailDirection       @default(OUTGOING)
  senderId         String
  parentMailId     String?
  threadRootId     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sentAt           DateTime?

  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type               MailType                @relation(fields: [typeId], references: [id])
  sender             User                    @relation("MailSender", fields: [senderId], references: [id])
  parentMail         Mail?                   @relation("MailReplies", fields: [parentMailId], references: [id])
  replies            Mail[]                  @relation("MailReplies")
  recipients         MailRecipient[]
  attachments        MailAttachment[]
  documentReferences MailDocumentReference[]
  relatedMails       MailRelatedMail[]       @relation("MailRelatedMailFromMail")
  relatedByMails     MailRelatedMail[]       @relation("MailRelatedMailToMail")

  @@unique([projectId, mailNumber])
  @@index([projectId, status])
  @@index([projectId, workflowStatus])
  @@index([threadRootId])
  @@index([senderId])
  @@index([typeId])
}

/**
 * A real reference from an incoming (or any) mail to an existing, official
 * Document Register document — created via Attach > Document. Does not
 * duplicate or modify the Document/DocumentVersion it points to.
 */
model MailDocumentReference {
  id                String   @id @default(cuid())
  mailId            String
  documentId        String
  /**
   * Snapshot of the specific DocumentVersion that was actually attached at
   * the time this reference was created (nullable — older references from
   * before this field existed, or plain Attach>Document references that
   * don't need transmittal-grade accuracy, leave it unset). Without this,
   * `document.currentRevision` is a live, mutable pointer — if the document
   * is revised again later, a transmittal's "attached revision" would
   * silently drift to the new revision instead of showing what was
   * actually issued.
   */
  documentVersionId String?
  /**
   * Denormalized copy of the revision label at issue time, for resilient
   * display even independent of the versionId row.
   */
  revisionAtIssue   String?
  createdById       String
  createdAt         DateTime @default(now())

  mail            Mail             @relation(fields: [mailId], references: [id], onDelete: Cascade)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])

  @@unique([mailId, documentId])
  @@index([documentId])
  @@index([documentVersionId])
}

/**
 * A real reference from one mail to another existing mail — created via
 * Attach > Project Mail. Deliberately distinct from parentMailId/threadRootId,
 * which are reserved for Reply/Reply All/Forward threading only.
 */
model MailRelatedMail {
  id            String   @id @default(cuid())
  mailId        String
  relatedMailId String
  createdById   String
  createdAt     DateTime @default(now())

  mail        Mail @relation("MailRelatedMailFromMail", fields: [mailId], references: [id], onDelete: Cascade)
  relatedMail Mail @relation("MailRelatedMailToMail", fields: [relatedMailId], references: [id], onDelete: Cascade)
  createdBy   User @relation(fields: [createdById], references: [id])

  @@unique([mailId, relatedMailId])
  @@index([relatedMailId])
}

enum RecipientType {
  TO
  CC
}

model MailRecipient {
  id     String        @id @default(cuid())
  mailId String
  userId String
  type   RecipientType
  readAt DateTime?

  mail Mail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([mailId, userId, type])
  @@index([userId])
}

model MailAttachment {
  id         String   @id @default(cuid())
  mailId     String
  fileName   String
  storedPath String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  mail Mail @relation(fields: [mailId], references: [id], onDelete: Cascade)

  @@index([mailId])
}

/**
 * A reusable text/HTML snippet a user can insert into a mail message body
 * (e.g. standard openings/closings). Project-scoped like MailType.
 */
model AutoText {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  contentHtml String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AutoTextCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, name])
  @@index([projectId])
}

/**
 * A reusable sign-off block a user can insert into a mail message body.
 * Personal to the user (not project-scoped) — a user's signature travels
 * with them across projects.
 */
model Signature {
  id          String   @id @default(cuid())
  userId      String
  name        String
  contentHtml String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * An image embedded inline in a mail message body via the rich-text editor.
 * Stored on disk like every other upload; referenced from messageHtml by
 * its serving URL rather than embedded as base64. Uploaded independently of
 * the mail itself (during composition), so it needs its own project scope
 * for authorization rather than a mailId foreign key.
 */
model MailInlineImage {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("MailInlineImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Folder {
  id        String   @id @default(cuid())
  projectId String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderChildren", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderChildren")
  documents Document[]

  @@index([projectId, parentId])
}

model DocumentType {
  id        String  @id @default(cuid())
  projectId String
  name      String
  /** Marks this type as belonging to the Drawings register (vs. general
   * document types) — project-configurable, not a hardcoded name match. */
  isDrawingType Boolean @default(false)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([projectId, name])
}

enum DocumentMetadataCategory {
  DISCIPLINE
  FUNCTIONAL_BREAKDOWN
  SPATIAL_BREAKDOWN
}

/**
 * Real, project-configurable value lists for Discipline / Functional
 * Breakdown / Spatial Breakdown — a single generic table rather than three
 * near-identical models. Document itself keeps these as plain nullable
 * strings (matching the existing `discipline` field precedent) so existing
 * filters/exports/edit-metadata code needs no breaking changes; this table
 * only supplies the real dropdown options instead of a hardcoded array, and
 * new values can be added inline from the document metadata forms.
 */
model DocumentMetadataOption {
  id        String                   @id @default(cuid())
  projectId String
  category  DocumentMetadataCategory
  name      String
  createdAt DateTime                 @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category, name])
  @@index([projectId, category])
}

enum DocumentReviewStatus {
  A_NO_OBJECTION
  B_NO_OBJECTION_WITH_COMMENTS
  C_REVISE_RESUBMIT
}

/// Which register a Document actually belongs to (see Document.registerScope).
enum DocumentRegisterScope {
  STANDALONE_DOCUMENT
  DRAWING
  /// Reserved for a Document whose only real purpose is being referenced
  /// from a Mail (see MailDocumentReference) rather than standing on its
  /// own in either register — not currently assigned to any record.
  MAIL_ATTACHMENT_REFERENCE
  /// Real, imported data intentionally held out of the visible Document
  /// Register pending review — not deleted, not archived, just not yet
  /// approved for standalone visibility.
  MIGRATION_HOLD
  ARCHIVED
}

enum DocumentStatus {
  DRAFT
  FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  APPROVED_WITH_COMMENTS
  REJECTED
  REVISE_RESUBMIT
  SUPERSEDED
  WITHDRAWN
  CLOSED
  NO_LONGER_IN_USE
  /// Aconex-native review-cycle statuses (distinct from the generic
  /// approval-workflow ones above) — added because real imported project
  /// data uses this exact vocabulary and forcing it into APPROVED/REJECTED
  /// would misrepresent the source status.
  FOR_ACTION
  FOR_INFORMATION
  NO_OBJECTION
  NO_OBJECTION_WITH_COMMENTS
  NO_STATUS
}

model Document {
  id                  String                @id @default(cuid())
  projectId           String
  documentNo          String
  title               String
  description         String?
  typeId              String?
  folderId            String?
  discipline          String?
  /**
   * Project-configurable classification (see DocumentMetadataOption) — a
   * WBS/location-style breakdown used mainly for drawings but available to
   * any document.
   */
  functionalBreakdown String?
  spatialBreakdown    String?
  /**
   * Distinct from `status`: the reviewer's disposition on the current
   * revision (Aconex-style A/B/C review outcome), independent of the
   * document's own lifecycle status. Null = no review outcome recorded yet.
   */
  reviewStatus        DocumentReviewStatus?
  status              DocumentStatus        @default(DRAFT)
  currentRevision     String                @default("0")
  /**
   * A registered Document with no uploaded file yet — a real, reserved
   * record (number, title, type, metadata) awaiting its first file. Flips
   * to false automatically the moment a first DocumentVersion is added.
   */
  isPlaceholder       Boolean               @default(false)
  /**
   * Which register this Document actually belongs to — the authoritative,
   * server-enforced separation between the Document Register and Drawings
   * (previously the two pages shared one query with no scope filter at
   * all, so the Document Register silently showed drawings too). Derived
   * automatically from the resolved DocumentType.isDrawingType whenever a
   * document is created or its type changes; MIGRATION_HOLD is a real,
   * non-destructive lifecycle state for imported records not yet reviewed
   * for standalone-register visibility — never a delete, never CSS-hidden.
   */
  registerScope       DocumentRegisterScope @default(STANDALONE_DOCUMENT)
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                DocumentType?              @relation(fields: [typeId], references: [id])
  folder              Folder?                    @relation(fields: [folderId], references: [id])
  createdBy           User                       @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  versions            DocumentVersion[]
  temporaryFileOrigin TemporaryFile?
  mailReferences      MailDocumentReference[]
  printRequests       PrintRequestDocument[]
  workflowDocuments   WorkflowDocument[]
  fieldDocumentReferences FieldDocumentReference[]

  @@unique([projectId, documentNo])
  @@index([projectId, folderId])
  @@index([projectId, status])
  @@index([projectId, discipline])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  revision     String
  versionNo    Int
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  notes        String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  document       Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy     User                    @relation("DocumentVersionUploadedBy", fields: [uploadedById], references: [id])
  mailReferences MailDocumentReference[]
  workflowDocuments WorkflowDocument[]
  fieldDocumentReferences FieldDocumentReference[]

  @@unique([documentId, versionNo])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Temporary Files — uploaded project files that are not yet part of the
// official Document Register. A Temporary File becomes an official Document
// (with its own DocumentVersion) only when a user explicitly registers it;
// uploading never creates a Document on its own.
// ---------------------------------------------------------------------------

enum TemporaryFileStatus {
  TEMPORARY
  PROCESSING
  REGISTERED
}

model TemporaryFile {
  id                   String              @id @default(cuid())
  projectId            String
  uploadedById         String
  originalFileName     String
  storedPath           String
  mimeType             String
  sizeBytes            Int
  uploadedAt           DateTime            @default(now())
  status               TemporaryFileStatus @default(TEMPORARY)
  registeredDocumentId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy         User      @relation("TemporaryFileUploadedBy", fields: [uploadedById], references: [id])
  registeredDocument Document? @relation(fields: [registeredDocumentId], references: [id])

  @@index([projectId, status])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// Print requests
// ---------------------------------------------------------------------------

/**
 * A real, persisted print request submitted against one or more selected
 * documents — distinct from the existing browser-print view, which never
 * creates a record.
 */
model PrintRequest {
  id            String   @id @default(cuid())
  projectId     String
  requestedById String
  details       String
  createdAt     DateTime @default(now())

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User                   @relation(fields: [requestedById], references: [id])
  documents   PrintRequestDocument[]

  @@index([projectId])
}

model PrintRequestDocument {
  id             String @id @default(cuid())
  printRequestId String
  documentId     String

  printRequest PrintRequest @relation(fields: [printRequestId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([printRequestId, documentId])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Workflows — a real, template-driven review state machine. Distinct from
// (and never merged with) any future Document Process engine: a Workflow is
// a reviewer sign-off sequence over a fixed set of documents; a Document
// Process would be a metadata-routed deliverable/issue engine. Step
// history and reviewer decisions are never overwritten — only ever
// appended, matching the project's auditable-record principle.
// ---------------------------------------------------------------------------

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// How a workflow's single final outcome is derived from its steps.
/// FINAL_STEP_OUTCOME: whatever the last step group decided wins.
/// LOWEST_OF_ALL_STEP_OUTCOMES: the most severe outcome reached by ANY step
/// wins, even if a later step reached a better one (severity is
/// WorkflowOutcomeOption.severityRank, higher = worse).
enum WorkflowOutcomeRule {
  FINAL_STEP_OUTCOME
  LOWEST_OF_ALL_STEP_OUTCOMES
}

/// How a step with multiple reviewers decides it is done.
/// ALL_REVIEWERS: every assigned reviewer must submit before the step (and
/// the next step group) can proceed.
/// ANY_REVIEWER: the first submission completes the step.
/// REJECT_ON_ANY_REJECTION: like ALL_REVIEWERS, except a single reviewer
/// marking a rejecting outcome immediately completes the step (and, per the
/// template's outcome rule, may immediately fail the whole workflow)
/// without waiting for the remaining reviewers.
enum WorkflowStepCompletionRule {
  ALL_REVIEWERS
  ANY_REVIEWER
  REJECT_ON_ANY_REJECTION
}

enum WorkflowStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
  TERMINATED
}

enum WorkflowStepInstanceStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
  TERMINATED
}

/// A project-configurable review outcome value (Aconex-style A/B/C/D review
/// status set) — real DB-backed master data, never hard-coded, per the
/// explicit requirement that outcome values be project-configurable.
model WorkflowOutcomeOption {
  id            String  @id @default(cuid())
  projectId     String
  code          String
  label         String
  /// Higher = more severe/worse outcome — drives LOWEST_OF_ALL_STEP_OUTCOMES
  /// and REJECT_ON_ANY_REJECTION.
  severityRank  Int
  isRejection   Boolean @default(false)
  sortOrder     Int     @default(0)
  createdById   String
  createdAt     DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([projectId, code])
  @@index([projectId])
}

model WorkflowTemplate {
  id          String                 @id @default(cuid())
  projectId   String
  name        String
  description String?
  outcomeRule WorkflowOutcomeRule    @default(FINAL_STEP_OUTCOME)
  status      WorkflowTemplateStatus @default(DRAFT)
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                   @relation(fields: [createdById], references: [id])
  steps     WorkflowTemplateStep[]
  workflows Workflow[]

  @@unique([projectId, name])
  @@index([projectId, status])
}

/// Steps sharing the same groupNo within a template run in parallel; groups
/// run in ascending groupNo order — this single field is what makes
/// serial and parallel steps the same underlying structure instead of two
/// separate concepts.
model WorkflowTemplateStep {
  id               String                     @id @default(cuid())
  templateId       String
  name             String
  groupNo          Int
  durationDays     Int                        @default(5)
  completionRule   WorkflowStepCompletionRule @default(ALL_REVIEWERS)
  commentsRequired Boolean                    @default(false)

  template  WorkflowTemplate               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  reviewers WorkflowTemplateStepReviewer[]

  @@unique([templateId, name])
  @@index([templateId, groupNo])
}

model WorkflowTemplateStepReviewer {
  id             String @id @default(cuid())
  templateStepId String
  userId         String

  templateStep WorkflowTemplateStep @relation(fields: [templateStepId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id])

  @@unique([templateStepId, userId])
}

model Workflow {
  id               String              @id @default(cuid())
  projectId        String
  /// Real, human-facing sequential number ("<PROJECT CODE>-WF-00001"),
  /// generated the same way as Mail's mailNumber — distinct from the
  /// internal cuid `id`, and what Workflow Search's "Workflow No." field
  /// searches against.
  workflowNumber   String
  templateId       String?
  title            String
  outcomeRule      WorkflowOutcomeRule
  status           WorkflowStatus      @default(IN_PROGRESS)
  initiatedById    String
  /// Set when this workflow was started from an active review as a
  /// subworkflow — parent/child relationship is explicit and queryable.
  parentWorkflowId String?
  finalOutcomeCode String?
  terminatedReason String?
  /// Snapshot of the first step group's due date at start time — unlike a
  /// step's own dueDate (which reflects whichever step is currently
  /// active), this never changes once the workflow starts, matching
  /// Workflow Search's "Original Due Date" field.
  originalDueDate  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  completedAt      DateTime?

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template       WorkflowTemplate?      @relation(fields: [templateId], references: [id])
  initiatedBy    User                   @relation("WorkflowInitiatedBy", fields: [initiatedById], references: [id])
  parentWorkflow Workflow?              @relation("Subworkflow", fields: [parentWorkflowId], references: [id])
  subworkflows   Workflow[]             @relation("Subworkflow")
  documents      WorkflowDocument[]
  steps          WorkflowStepInstance[]
  events         WorkflowEvent[]

  @@unique([projectId, workflowNumber])
  @@index([projectId, status])
  @@index([parentWorkflowId])
}

model WorkflowDocument {
  id                String @id @default(cuid())
  workflowId        String
  documentId        String
  /// Snapshot of the version actually under review at start time — the
  /// same anti-drift pattern used by MailDocumentReference.
  documentVersionId String?

  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id])

  @@unique([workflowId, documentId])
  @@index([documentId])
}

model WorkflowStepInstance {
  id               String                     @id @default(cuid())
  workflowId       String
  templateStepId   String?
  name             String
  groupNo          Int
  durationDays     Int                        @default(5)
  completionRule   WorkflowStepCompletionRule
  commentsRequired Boolean                    @default(false)
  status           WorkflowStepInstanceStatus @default(PENDING)
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  /// This step's own aggregated outcome once complete (the most severe
  /// outcome among its reviewers).
  outcomeCode      String?

  workflow  Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviewers WorkflowStepReviewer[]

  @@index([workflowId, groupNo])
}

model WorkflowStepReviewer {
  id             String    @id @default(cuid())
  stepInstanceId String
  userId         String
  outcomeCode    String?
  comments       String?
  reviewedAt     DateTime?

  stepInstance WorkflowStepInstance @relation(fields: [stepInstanceId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id])

  @@unique([stepInstanceId, userId])
  @@index([userId])
}

/// Append-only workflow-specific event history — surfaced as the Workflow
/// detail page's Event Log, distinct from the general AuditLog (which also
/// gets a matching entry for cross-module audit consistency).
model WorkflowEvent {
  id         String   @id @default(cuid())
  workflowId String
  action     String
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor    User?    @relation("WorkflowEventActor", fields: [actorId], references: [id])

  @@index([workflowId, createdAt])
}

// ---------------------------------------------------------------------------
// Saved searches / audit
// ---------------------------------------------------------------------------

enum SearchModule {
  MAIL
  DOCUMENTS
  WORKFLOWS
}

model SavedSearch {
  id        String       @id @default(cuid())
  userId    String
  projectId String
  module    SearchModule
  name      String
  filters   Json
  createdAt DateTime     @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, module, name])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  projectId  String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, entityType, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// RBAC — granular permissions, layered alongside (not replacing) the
// existing ProjectMember.role coarse gate. Existing requireProjectRole()
// checks on Documents/Mail/Workflow are untouched; this powers only the new
// Directory/Mailing-Group/RBAC-admin surface introduced alongside it, plus
// whatever is migrated onto it later.
// ---------------------------------------------------------------------------

enum RoleScope {
  ORGANIZATION
  PROJECT
}

model Permission {
  id          String @id @default(cuid())
  /// Stable machine key, e.g. "DIRECTORY_CREATE_GUEST" — referenced directly
  /// in code via requirePermission(), never a free-text string at call sites.
  code        String @unique
  description String
  category    String

  rolePermissions RolePermission[]

  @@index([category])
}

model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  scope       RoleScope
  /// System roles (Project Administrator/Member/Viewer, seeded from the
  /// existing ProjectRole enum) cannot be deleted — they are the
  /// compatibility bridge for every existing ProjectMember.
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([name, scope])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

/// A user's grant of one Role, scoped to a specific project (PROJECT-scope
/// roles) or organization (ORGANIZATION-scope roles). One user can hold
/// several — e.g. Project Administrator on Project A and Project Member on
/// Project B — since scope is carried per-assignment, not on the user.
model UserRoleAssignment {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  projectId      String?
  organizationId String?
  createdById    String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("UserRoleAssignmentGrantedBy", fields: [createdById], references: [id])

  @@unique([userId, roleId, projectId, organizationId])
  @@index([userId])
  @@index([projectId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Mailing Groups — real distribution groups, selectable in the Mail
// recipient picker alongside individual Directory users.
// ---------------------------------------------------------------------------

model MailingGroup {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  organizationId String?
  /// Locked groups reject membership changes from anyone without
  /// DIRECTORY_MANAGE_GROUP_MEMBERS — enforced server-side, not just a
  /// disabled button.
  locked         Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization?        @relation(fields: [organizationId], references: [id])
  createdBy    User                 @relation("MailingGroupCreatedBy", fields: [createdById], references: [id])
  members      MailingGroupMember[]

  @@unique([projectId, name])
}

model MailingGroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String

  group MailingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Health & Safety
// ---------------------------------------------------------------------------

enum HseSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseLikelihood {
  RARE
  UNLIKELY
  POSSIBLE
  LIKELY
  ALMOST_CERTAIN
}

enum HseRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseControlHierarchy {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING
  ADMINISTRATIVE
  PPE
}

enum HseControlStatus {
  PLANNED
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
}

/// Generic evidence attachment reused across every HSE record type via a
/// polymorphic recordType+recordId pair (recordType is the literal model
/// name, e.g. "HseIncident") — the same pattern this codebase already uses
/// for AuditLog, rather than seven near-identical join tables.
model HseAttachment {
  id           String   @id @default(cuid())
  recordType   String
  recordId     String
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([recordType, recordId])
}

enum HseObservationType {
  UNSAFE_ACT
  UNSAFE_CONDITION
  POSITIVE_OBSERVATION
  SAFETY_IMPROVEMENT
}

enum HseObservationStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model HseObservation {
  id                String                @id @default(cuid())
  projectId         String
  observationNumber String
  type              HseObservationType
  title             String
  description       String
  location          String
  building          String?
  floor             String?
  area              String?
  latitude          Float?
  longitude         Float?
  severity          HseSeverity           @default(LOW)
  status            HseObservationStatus  @default(OPEN)
  reportedById      String
  reportedAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("HseObservationReportedBy", fields: [reportedById], references: [id])

  @@unique([projectId, observationNumber])
  @@index([projectId, status])
}

enum HseIncidentType {
  INJURY
  ILLNESS
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  SECURITY
  OTHER
}

enum HseIncidentStatus {
  REPORTED
  TRIAGED
  UNDER_INVESTIGATION
  CORRECTIVE_ACTION
  VERIFICATION
  CLOSED
}

model HseIncident {
  id                  String            @id @default(cuid())
  projectId           String
  incidentNumber      String
  type                HseIncidentType
  title               String
  description         String
  location            String
  building            String?
  floor               String?
  area                String?
  latitude            Float?
  longitude           Float?
  severity            HseSeverity       @default(LOW)
  status              HseIncidentStatus @default(REPORTED)
  incidentDate        DateTime
  incidentTime        String?
  immediateCause      String?
  contributingFactors String?
  rootCause           String?
  reportedById        String
  reportedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User                @relation("HseIncidentReportedBy", fields: [reportedById], references: [id])
  people     HseIncidentPerson[]

  @@unique([projectId, incidentNumber])
  @@index([projectId, status])
}

model HseIncidentPerson {
  id           String  @id @default(cuid())
  incidentId   String
  userId       String?
  name         String
  role         String
  organization String?

  incident HseIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id])

  @@index([incidentId])
}

enum HseNearMissStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model HseNearMiss {
  id                   String            @id @default(cuid())
  projectId            String
  nearMissNumber       String
  title                String
  description          String
  whatHappened         String?
  potentialConsequence String?
  potentialSeverity    HseSeverity       @default(LOW)
  immediateAction      String?
  location             String
  building             String?
  floor                String?
  area                 String?
  latitude             Float?
  longitude            Float?
  status               HseNearMissStatus @default(OPEN)
  assignedToId         String?
  dueDate              DateTime?
  reportedById         String
  reportedAt           DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("HseNearMissReportedBy", fields: [reportedById], references: [id])
  assignedTo User?   @relation("HseNearMissAssignedTo", fields: [assignedToId], references: [id])

  @@unique([projectId, nearMissNumber])
  @@index([projectId, status])
}

enum HseHazardStatus {
  OPEN
  CONTROLLED
  CLOSED
}

model HseHazard {
  id                 String          @id @default(cuid())
  projectId          String
  hazardNumber       String
  hazard             String
  activity           String?
  location           String
  initialLikelihood  HseLikelihood
  initialSeverity    HseSeverity
  initialRisk        HseRiskLevel
  residualLikelihood HseLikelihood?
  residualSeverity   HseSeverity?
  residualRisk       HseRiskLevel?
  responsibleId      String?
  reviewDate         DateTime?
  status             HseHazardStatus @default(OPEN)
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User?        @relation("HseHazardResponsible", fields: [responsibleId], references: [id])
  createdBy   User         @relation("HseHazardCreatedBy", fields: [createdById], references: [id])
  controls    HseControl[]

  @@unique([projectId, hazardNumber])
  @@index([projectId, status])
}

enum HseRiskAssessmentStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

model HseRiskAssessment {
  id                   String                  @id @default(cuid())
  projectId            String
  assessmentNumber     String
  activity             String
  task                 String?
  hazard               String
  potentialConsequence String?
  initialLikelihood    HseLikelihood
  initialSeverity      HseSeverity
  initialRisk          HseRiskLevel
  residualLikelihood   HseLikelihood?
  residualSeverity     HseSeverity?
  residualRisk         HseRiskLevel?
  responsibleId        String?
  reviewDate           DateTime?
  status               HseRiskAssessmentStatus @default(DRAFT)
  createdById          String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User?        @relation("HseRiskAssessmentResponsible", fields: [responsibleId], references: [id])
  createdBy   User         @relation("HseRiskAssessmentCreatedBy", fields: [createdById], references: [id])
  controls    HseControl[]

  @@unique([projectId, assessmentNumber])
  @@index([projectId, status])
}

/// Shared by both Hazards and Risk Assessments — a control belongs to
/// exactly one of the two (never both), matching the hierarchy-of-controls
/// concept used in both registers.
model HseControl {
  id               String               @id @default(cuid())
  hazardId         String?
  riskAssessmentId String?
  hierarchy        HseControlHierarchy
  description      String
  ownerId          String?
  dueDate          DateTime?
  status           HseControlStatus     @default(PLANNED)
  verifiedAt       DateTime?

  hazard         HseHazard?         @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  riskAssessment HseRiskAssessment? @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  owner          User?              @relation(fields: [ownerId], references: [id])

  @@index([hazardId])
  @@index([riskAssessmentId])
}

enum HseInspectionQuestionType {
  YES_NO
  PASS_FAIL
  TEXT
  NUMERIC
  PHOTO
}

model HseInspectionTemplate {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation(fields: [createdById], references: [id])
  questions   HseInspectionQuestion[]
  inspections HseInspection[]

  @@unique([projectId, name])
}

model HseInspectionQuestion {
  id         String                    @id @default(cuid())
  templateId String
  sortOrder  Int
  section    String?
  text       String
  type       HseInspectionQuestionType
  required   Boolean                   @default(true)

  template  HseInspectionTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses HseInspectionResponse[]

  @@index([templateId, sortOrder])
}

enum HseInspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model HseInspection {
  id               String               @id @default(cuid())
  projectId        String
  inspectionNumber String
  templateId       String
  location         String
  inspectorId      String
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  status           HseInspectionStatus  @default(SCHEDULED)
  result           String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template  HseInspectionTemplate    @relation(fields: [templateId], references: [id])
  inspector User                     @relation(fields: [inspectorId], references: [id])
  responses HseInspectionResponse[]

  @@unique([projectId, inspectionNumber])
  @@index([projectId, status])
}

model HseInspectionResponse {
  id           String  @id @default(cuid())
  inspectionId String
  questionId   String
  answer       String?
  comment      String?

  inspection HseInspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  question   HseInspectionQuestion  @relation(fields: [questionId], references: [id])

  @@unique([inspectionId, questionId])
}

enum HseActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HseCorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  CLOSED
}

model HseCorrectiveAction {
  id           String                    @id @default(cuid())
  projectId    String
  actionNumber String
  sourceType   String
  sourceId     String?
  description  String
  assignedToId String?
  priority     HseActionPriority         @default(MEDIUM)
  dueDate      DateTime?
  status       HseCorrectiveActionStatus @default(OPEN)
  completedAt  DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("HseActionAssignedTo", fields: [assignedToId], references: [id])
  verifiedBy User?   @relation("HseActionVerifiedBy", fields: [verifiedById], references: [id])
  createdBy  User    @relation("HseActionCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, actionNumber])
  @@index([projectId, status])
  @@index([assignedToId])
  @@index([sourceType, sourceId])
}

enum HsePermitType {
  HOT_WORK
  WORK_AT_HEIGHT
  ELECTRICAL
  CONFINED_SPACE
  OTHER
}

enum HsePermitStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  EXPIRED
  CLOSED
}

model HsePermit {
  id              String          @id @default(cuid())
  projectId       String
  permitNumber    String
  type            HsePermitType
  location        String
  workDescription String
  contractorOrg   String?
  requestedById   String
  startDate       DateTime
  endDate         DateTime
  hazards         String?
  controls        String?
  requiredPpe     String?
  precautions     String?
  status          HsePermitStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User                 @relation(fields: [requestedById], references: [id])
  approvals   HsePermitApproval[]

  @@unique([projectId, permitNumber])
  @@index([projectId, status])
}

model HsePermitApproval {
  id         String    @id @default(cuid())
  permitId   String
  approverId String
  decision   String?
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  permit   HsePermit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approver User      @relation(fields: [approverId], references: [id])

  @@index([permitId])
}

// ---------------------------------------------------------------------------
// HSE — Equipment / Plant Safety
//
// Distinct from HseInspection (which inspects a site/activity/location):
// this determines whether a specific piece of equipment/plant is safe to
// operate. Reuses HseAttachment (recordType "HseEquipment"/
// "HseEquipmentInspection"), HseCorrectiveAction (sourceType
// "HseEquipmentInspection"), AuditLog, and HSE numbering — no duplicate
// infrastructure. equipmentType is validated free text (see
// src/lib/hse/equipment.ts), not an enum, so new equipment categories never
// require a migration.
// ---------------------------------------------------------------------------

enum HseEquipmentStatus {
  AVAILABLE
  INSPECTION_DUE
  UNDER_INSPECTION
  PASSED
  FAILED
  OUT_OF_SERVICE
  UNDER_REPAIR
  RELEASED
}

model HseEquipment {
  id                  String             @id @default(cuid())
  projectId           String
  equipmentNumber     String
  equipmentType       String
  description         String
  makeModel           String?
  serialNumber        String?
  location            String?
  organizationId      String?
  responsiblePersonId String?
  status              HseEquipmentStatus @default(AVAILABLE)
  riskLevel           HseRiskLevel?
  lastInspectionAt    DateTime?
  nextInspectionDue   DateTime?
  createdById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization      Organization?            @relation(fields: [organizationId], references: [id])
  responsiblePerson User?                    @relation("HseEquipmentResponsible", fields: [responsiblePersonId], references: [id])
  createdBy         User                     @relation("HseEquipmentCreatedBy", fields: [createdById], references: [id])
  inspections       HseEquipmentInspection[]

  @@unique([projectId, equipmentNumber])
  @@index([projectId, status])
}

enum HseEquipmentInspectionResult {
  PASS
  FAIL
}

model HseEquipmentInspection {
  id                   String                       @id @default(cuid())
  projectId            String
  equipmentId          String
  inspectionNumber     String
  inspectorId          String
  inspectedAt          DateTime                     @default(now())
  result               HseEquipmentInspectionResult
  previousInspectionId String?
  createdAt            DateTime                     @default(now())

  project            Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment          HseEquipment                 @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspector          User                         @relation("HseEquipmentInspectionInspector", fields: [inspectorId], references: [id])
  previousInspection HseEquipmentInspection?      @relation("HseEquipmentReinspection", fields: [previousInspectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reinspections      HseEquipmentInspection[]     @relation("HseEquipmentReinspection")
  items              HseEquipmentInspectionItem[]

  @@unique([projectId, inspectionNumber])
  @@index([equipmentId])
}

enum HseChecklistResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

model HseEquipmentInspectionItem {
  id           String             @id @default(cuid())
  inspectionId String
  label        String
  result       HseChecklistResult
  comment      String?
  severity     HseSeverity?
  sortOrder    Int                @default(0)

  inspection HseEquipmentInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

// ---------------------------------------------------------------------------
// HSE — Emergency Management
//
// A practical construction-site emergency management area: contacts,
// procedures, real emergency events, and drills with attendance/findings.
// Findings reuse HseCorrectiveAction (sourceType "HseEmergencyDrillFinding")
// rather than a parallel action system; evidence reuses HseAttachment.
// ---------------------------------------------------------------------------

model HseEmergencyContact {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  role           String
  organizationId String?
  phone          String
  email          String?
  emergencyType  String?
  location       String?
  availability   String?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation("HseEmergencyContactCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

enum HseEmergencyProcedureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model HseEmergencyProcedure {
  id                     String                      @id @default(cuid())
  projectId              String
  title                  String
  emergencyType          String
  immediateActions       String
  evacuationInstructions String?
  assemblyPoint          String?
  requiredEquipment      String?
  steps                  String?
  status                 HseEmergencyProcedureStatus @default(DRAFT)
  lastReviewedAt         DateTime?
  reviewedById           String?
  createdById            String
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("HseEmergencyProcedureReviewedBy", fields: [reviewedById], references: [id])
  createdBy  User    @relation("HseEmergencyProcedureCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, status])
}

enum HseEmergencyEventStatus {
  REPORTED
  RESPONDING
  UNDER_REVIEW
  FOLLOW_UP
  CLOSED
}

model HseEmergencyEvent {
  id                        String                   @id @default(cuid())
  projectId                 String
  eventNumber               String
  emergencyType             String
  occurredAt                DateTime
  location                  String
  reportedById              String
  severity                  HseSeverity
  description               String
  immediateActions          String?
  peopleAffected            String?
  emergencyServicesContacted Boolean                 @default(false)
  evacuationRequired        Boolean                  @default(false)
  assemblyPoint             String?
  status                    HseEmergencyEventStatus  @default(REPORTED)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy User    @relation("HseEmergencyEventReportedBy", fields: [reportedById], references: [id])

  @@unique([projectId, eventNumber])
  @@index([projectId, status])
}

enum HseEmergencyDrillResult {
  SATISFACTORY
  NEEDS_IMPROVEMENT
  UNSATISFACTORY
}

enum HseEmergencyDrillStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model HseEmergencyDrill {
  id                   String                    @id @default(cuid())
  projectId            String
  drillNumber          String
  drillType            String
  scheduledAt          DateTime
  location             String
  scenario             String?
  coordinatorId        String
  expectedParticipants Int?
  actualParticipants   Int?
  assemblyPoint        String?
  startedAt            DateTime?
  endedAt              DateTime?
  observations         String?
  result               HseEmergencyDrillResult?
  status               HseEmergencyDrillStatus   @default(SCHEDULED)
  createdById          String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  project     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coordinator User                        @relation("HseEmergencyDrillCoordinator", fields: [coordinatorId], references: [id])
  createdBy   User                        @relation("HseEmergencyDrillCreatedBy", fields: [createdById], references: [id])
  attendees   HseEmergencyDrillAttendee[]
  findings    HseEmergencyDrillFinding[]

  @@unique([projectId, drillNumber])
  @@index([projectId, status])
}

model HseEmergencyDrillAttendee {
  id               String  @id @default(cuid())
  drillId          String
  userId           String?
  organizationName String?
  present          Boolean @default(true)
  role             String?

  drill HseEmergencyDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)
  user  User?             @relation("HseEmergencyDrillAttendeeUser", fields: [userId], references: [id])

  @@index([drillId])
}

model HseEmergencyDrillFinding {
  id       String      @id @default(cuid())
  drillId  String
  issue    String
  severity HseSeverity
  finding  String

  drill HseEmergencyDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@index([drillId])
}

// ---------------------------------------------------------------------------
// Field — construction field operations (Observations, Inspections, Issues,
// Punch/Snagging, ITP/Hold Points, Tests, Photos, Reports). Shared primitives
// first: location hierarchy, polymorphic attachments/document-references
// (mirroring HseAttachment / MailDocumentReference exactly), configurable
// type lookups, and a polymorphic comment thread. Per-area models arrive in
// later additive migrations as each area is built.
// ---------------------------------------------------------------------------

model FieldArea {
  id          String   @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  code        String?
  description String?
  /// Free text (e.g. "Building"/"Floor"/"Zone"/"Room") — not an enum, so a
  /// project's own hierarchy depth/vocabulary never requires a migration.
  levelType   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   FieldArea?  @relation("FieldAreaHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     FieldArea[] @relation("FieldAreaHierarchy")
  photos       FieldPhoto[]
  observations FieldObservation[]
  inspections  FieldInspection[]
  issues       FieldIssue[]
  punchlists   FieldPunchlist[]
  punchItems   FieldPunchItem[]
  itps         FieldItp[]
  tests        FieldTest[]
  siteWalks    FieldSiteWalk[]

  @@index([projectId, parentId])
}

/// Polymorphic evidence attachment reused across every Field record type via
/// recordType+recordId (recordType is the literal Prisma model name, e.g.
/// "FieldObservation") — the same pattern this codebase already uses for
/// HseAttachment, rather than a new table per Field area.
model FieldAttachment {
  id           String   @id @default(cuid())
  recordType   String
  recordId     String
  fileName     String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  /// Progress/Quality/Defect/Inspection/Before/After/General/Other —
  /// meaningful mainly for photo-tagged uploads, optional everywhere else.
  category     String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  uploadedBy       User        @relation(fields: [uploadedById], references: [id])
  photoOriginalFor FieldPhoto? @relation("FieldPhotoOriginal")
  photoMarkupFor   FieldPhoto? @relation("FieldPhotoMarkup")

  @@index([recordType, recordId])
}

/// Gives photos first-class gallery identity (search/filter/category) while
/// reusing FieldAttachment for the actual stored bytes. markupAttachmentId
/// is where a future annotated derivative attaches — attachmentId (the
/// original) is never overwritten or repointed.
model FieldPhoto {
  id                 String    @id @default(cuid())
  projectId          String
  attachmentId       String    @unique
  markupAttachmentId String?   @unique
  areaId             String?
  siteWalkId         String?
  capturedAt         DateTime?
  createdById        String
  createdAt          DateTime  @default(now())

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachment       FieldAttachment  @relation("FieldPhotoOriginal", fields: [attachmentId], references: [id], onDelete: Cascade)
  markupAttachment FieldAttachment? @relation("FieldPhotoMarkup", fields: [markupAttachmentId], references: [id])
  area             FieldArea?       @relation(fields: [areaId], references: [id])
  siteWalk         FieldSiteWalk?   @relation(fields: [siteWalkId], references: [id])
  createdBy        User             @relation("FieldPhotoCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
}

/// A guided site inspection walk-through — observations, issues, punch
/// items, and photos captured while the walk is active are tagged with
/// siteWalkId so a single "what did we find on this walk" summary/report
/// can be generated afterward. endedAt null means the walk is still active.
model FieldSiteWalk {
  id          String    @id @default(cuid())
  projectId   String
  areaId      String?
  purpose     String
  startedById String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area         FieldArea?         @relation(fields: [areaId], references: [id])
  startedBy    User               @relation("FieldSiteWalkStartedBy", fields: [startedById], references: [id])
  observations FieldObservation[]
  issues       FieldIssue[]
  punchItems   FieldPunchItem[]
  photos       FieldPhoto[]

  @@index([projectId])
}

/// Polymorphic reference to a real Document/DocumentVersion (mirrors
/// MailDocumentReference's exact snapshot shape) — optionally pinned to a
/// normalized x/y coordinate for "place pin -> View on Drawing".
model FieldDocumentReference {
  id                String   @id @default(cuid())
  recordType        String
  recordId          String
  documentId        String
  documentVersionId String?
  revisionAtIssue   String?
  pinX              Float?
  pinY              Float?
  createdById       String
  createdAt         DateTime @default(now())

  document        Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@index([recordType, recordId])
  @@index([documentId])
}

/// Configurable type lists (Observation Type, Issue Type, Punch Trade, Test
/// Type, ...) as one small reusable per-project lookup table, discriminated
/// by `kind` — avoids both hardcoded enums and a near-identical table per
/// list.
model FieldLookup {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations FieldObservation[]
  issues       FieldIssue[]
  punchItems   FieldPunchItem[]
  tests        FieldTest[]

  @@unique([projectId, kind, name])
  @@index([projectId, kind])
}

/// Polymorphic comment thread reused by every Field detail page's Activity
/// tab — same recordType/recordId idiom as FieldAttachment.
model FieldComment {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([recordType, recordId])
}

enum FieldPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FieldInspectionClassification {
  R
  S
  W
  H
}

// ---------------------------------------------------------------------------
// Field — Site Observations. Distinct from HSE Observations (safety-focused)
// and distinct from a Field Issue (observation is informational by default;
// it is only converted into an Issue when action is genuinely required —
// see observation-service.ts's convertToIssue).
// ---------------------------------------------------------------------------

enum FieldObservationStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  VERIFICATION_REQUIRED
  VERIFIED
  CLOSED
}

model FieldObservation {
  id                  String                 @id @default(cuid())
  projectId           String
  observationNumber   String
  areaId              String?
  siteWalkId          String?
  title               String
  description         String
  typeId              String?
  priority            FieldPriority          @default(MEDIUM)
  isPositive          Boolean                @default(false)
  responsibleOrgId    String?
  responsibleUserId   String?
  dueDate             DateTime?
  status              FieldObservationStatus @default(OPEN)
  createdById         String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  closedById          String?
  closedAt            DateTime?

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area            FieldArea?     @relation(fields: [areaId], references: [id])
  siteWalk        FieldSiteWalk? @relation(fields: [siteWalkId], references: [id])
  type            FieldLookup?   @relation(fields: [typeId], references: [id])
  responsibleOrg  Organization?  @relation(fields: [responsibleOrgId], references: [id])
  responsibleUser User?          @relation("FieldObservationResponsible", fields: [responsibleUserId], references: [id])
  createdBy       User           @relation("FieldObservationCreatedBy", fields: [createdById], references: [id])
  closedBy        User?          @relation("FieldObservationClosedBy", fields: [closedById], references: [id])

  @@unique([projectId, observationNumber])
  @@index([projectId, status])
  @@index([areaId])
}

// ---------------------------------------------------------------------------
// Field — Quality Inspections. Distinct from a Site Observation (an
// inspection is a structured, template-driven checklist run against a
// specific location/activity). Submitting computes PASSED/FAILED server-side
// from whether any MANDATORY item failed — never a client-supplied result.
// ---------------------------------------------------------------------------

model FieldInspectionTemplate {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                         @relation(fields: [createdById], references: [id])
  groups      FieldInspectionTemplateGroup[]
  inspections FieldInspection[]

  @@index([projectId, isActive])
}

model FieldInspectionTemplateGroup {
  id         String @id @default(cuid())
  templateId String
  name       String
  sortOrder  Int    @default(0)

  template FieldInspectionTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    FieldInspectionTemplateItem[]

  @@index([templateId])
}

enum FieldResponseType {
  PASS_FAIL
  YES_NO
  TEXT
  NUMBER
  DATE
}

model FieldInspectionTemplateItem {
  id           String            @id @default(cuid())
  groupId      String
  label        String
  responseType FieldResponseType @default(PASS_FAIL)
  isMandatory  Boolean           @default(true)
  sortOrder    Int               @default(0)

  group     FieldInspectionTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responses FieldInspectionResponse[]

  @@index([groupId])
}

enum FieldInspectionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
  CLOSED
}

model FieldInspection {
  id               String                 @id @default(cuid())
  projectId        String
  inspectionNumber String
  templateId       String
  areaId           String?
  assigneeId       String?
  inspectorId      String?
  dueDate          DateTime?
  status           FieldInspectionStatus  @default(DRAFT)
  submittedAt      DateTime?
  createdById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template  FieldInspectionTemplate    @relation(fields: [templateId], references: [id])
  area      FieldArea?                 @relation(fields: [areaId], references: [id])
  assignee  User?                      @relation("FieldInspectionAssignee", fields: [assigneeId], references: [id])
  inspector User?                      @relation("FieldInspectionInspector", fields: [inspectorId], references: [id])
  createdBy User                       @relation("FieldInspectionCreatedBy", fields: [createdById], references: [id])
  responses FieldInspectionResponse[]

  @@unique([projectId, inspectionNumber])
  @@index([projectId, status])
  @@index([areaId])
}

enum FieldChecklistResult {
  PASS
  FAIL
  NA
  YES
  NO
}

/// Snapshots the template item's label at response time (`label`) so later
/// template edits never rewrite history — the response itself is the
/// permanent record of what was actually asked and answered.
model FieldInspectionResponse {
  id            String                @id @default(cuid())
  inspectionId  String
  templateItemId String
  label         String
  result        FieldChecklistResult?
  textValue     String?
  note          String?
  sortOrder     Int                   @default(0)

  inspection   FieldInspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem FieldInspectionTemplateItem  @relation(fields: [templateItemId], references: [id])

  @@index([inspectionId])
}

// ---------------------------------------------------------------------------
// Field — Site Issues. The real "action required" record — created manually
// or from an Observation/Inspection-item/Test/Punch/Photo via the generic
// sourceType/sourceId pair (mirrors HseCorrectiveAction's exact pattern).
// Independent verification is enforced server-side: the assignee can never
// verify their own work (see issue-service.ts).
// ---------------------------------------------------------------------------

enum FieldIssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WORK_DONE
  READY_FOR_VERIFICATION
  REJECTED
  VERIFIED
  CLOSED
  DISPUTED
}

model FieldIssue {
  id                String           @id @default(cuid())
  projectId         String
  issueNumber       String
  areaId            String?
  siteWalkId        String?
  title             String
  description       String
  typeId            String?
  priority          FieldPriority    @default(MEDIUM)
  responsibleOrgId  String?
  responsibleUserId String?
  dueDate           DateTime?
  sourceType        String           @default("manual")
  sourceId          String?
  status            FieldIssueStatus @default(OPEN)
  verifiedById      String?
  verifiedAt        DateTime?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  closedById        String?
  closedAt          DateTime?

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area            FieldArea?     @relation(fields: [areaId], references: [id])
  siteWalk        FieldSiteWalk? @relation(fields: [siteWalkId], references: [id])
  type            FieldLookup?   @relation(fields: [typeId], references: [id])
  responsibleOrg  Organization?  @relation(fields: [responsibleOrgId], references: [id])
  responsibleUser User?          @relation("FieldIssueResponsible", fields: [responsibleUserId], references: [id])
  verifiedBy      User?          @relation("FieldIssueVerifiedBy", fields: [verifiedById], references: [id])
  createdBy       User           @relation("FieldIssueCreatedBy", fields: [createdById], references: [id])
  closedBy        User?          @relation("FieldIssueClosedBy", fields: [closedById], references: [id])
  punchlistLinks  FieldPunchlistIssue[]

  @@unique([projectId, issueNumber])
  @@index([projectId, status])
  @@index([sourceType, sourceId])
  @@index([areaId])
}

// ---------------------------------------------------------------------------
// Field — Punch / Snagging. Punchlists GROUP related punch items; an
// existing FieldIssue can be attached to a punchlist via FieldPunchlistIssue
// instead of being re-created as a punch item, so the same underlying
// problem is never duplicated as two records.
// ---------------------------------------------------------------------------

enum FieldPunchlistStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model FieldPunchlist {
  id             String               @id @default(cuid())
  projectId      String
  punchlistNumber String
  title          String
  areaId         String?
  description    String?
  dueDate        DateTime?
  ownerId        String?
  status         FieldPunchlistStatus @default(OPEN)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  closedAt       DateTime?

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area      FieldArea?           @relation(fields: [areaId], references: [id])
  owner     User?                @relation("FieldPunchlistOwner", fields: [ownerId], references: [id])
  createdBy User                 @relation("FieldPunchlistCreatedBy", fields: [createdById], references: [id])
  items     FieldPunchItem[]
  issues    FieldPunchlistIssue[]

  @@unique([projectId, punchlistNumber])
  @@index([projectId, status])
}

/// Attaches an EXISTING FieldIssue to a punchlist without duplicating it as
/// a separate punch item.
model FieldPunchlistIssue {
  id          String @id @default(cuid())
  punchlistId String
  issueId     String

  punchlist FieldPunchlist @relation(fields: [punchlistId], references: [id], onDelete: Cascade)
  issue     FieldIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([punchlistId, issueId])
}

enum FieldPunchItemStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WORK_DONE
  READY_FOR_VERIFICATION
  REWORK_REQUIRED
  VERIFIED
  CLOSED
}

model FieldPunchItem {
  id                String               @id @default(cuid())
  projectId         String
  punchlistId       String?
  punchItemNumber   String
  title             String
  description       String
  areaId            String?
  siteWalkId        String?
  tradeId           String?
  priority          FieldPriority        @default(MEDIUM)
  responsibleOrgId  String?
  responsibleUserId String?
  dueDate           DateTime?
  status            FieldPunchItemStatus @default(OPEN)
  createdById       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  closedById        String?
  closedAt          DateTime?

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  punchlist       FieldPunchlist? @relation(fields: [punchlistId], references: [id])
  area            FieldArea?      @relation(fields: [areaId], references: [id])
  siteWalk        FieldSiteWalk?  @relation(fields: [siteWalkId], references: [id])
  trade           FieldLookup?    @relation(fields: [tradeId], references: [id])
  responsibleOrg  Organization?   @relation(fields: [responsibleOrgId], references: [id])
  responsibleUser User?           @relation("FieldPunchItemResponsible", fields: [responsibleUserId], references: [id])
  createdBy       User            @relation("FieldPunchItemCreatedBy", fields: [createdById], references: [id])
  closedBy        User?           @relation("FieldPunchItemClosedBy", fields: [closedById], references: [id])

  @@unique([projectId, punchItemNumber])
  @@index([projectId, status])
  @@index([punchlistId])
  @@index([areaId])
}

// ---------------------------------------------------------------------------
// Field — Inspection & Test Plans and Hold Points. HOLD_ACTIVE is only ever
// entered by an H-classified item; release to RELEASED only ever happens as
// the output of an approval decision (itp-service.ts) — never a direct
// client write, mirroring the Equipment Safety status-protection pattern.
// ---------------------------------------------------------------------------

enum FieldItpStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

model FieldItp {
  id               String         @id @default(cuid())
  projectId        String
  itpNumber        String
  title            String
  revision         String         @default("A")
  discipline       String?
  activity         String?
  description      String?
  areaId           String?
  responsibleOrgId String?
  status           FieldItpStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area           FieldArea?      @relation(fields: [areaId], references: [id])
  responsibleOrg Organization?   @relation(fields: [responsibleOrgId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])
  items          FieldItpItem[]

  @@unique([projectId, itpNumber])
  @@index([projectId, status])
}

enum FieldItpItemStatus {
  PENDING
  HOLD_ACTIVE
  INSPECTION_REQUESTED
  APPROVED
  REJECTED
  RELEASED
}

model FieldItpItem {
  id                 String                         @id @default(cuid())
  itpId              String
  sequence           Int
  activity           String
  inspectionType     FieldInspectionClassification
  responsibleOrgId   String?
  acceptanceCriteria String?
  status             FieldItpItemStatus             @default(PENDING)
  requestedAt        DateTime?
  decidedById        String?
  decidedAt          DateTime?
  decisionNote       String?

  itp            FieldItp      @relation(fields: [itpId], references: [id], onDelete: Cascade)
  responsibleOrg Organization? @relation(fields: [responsibleOrgId], references: [id])
  decidedBy      User?         @relation("FieldItpItemDecidedBy", fields: [decidedById], references: [id])

  @@unique([itpId, sequence])
  @@index([itpId, status])
}

// ---------------------------------------------------------------------------
// Field — Test & Inspection Results. Retest chain mirrors Equipment
// Safety's proven previousInspectionId self-relation exactly — history is
// never overwritten, a failed test's retest is always a new row linked back.
// ---------------------------------------------------------------------------

enum FieldTestResult {
  PASS
  FAIL
  PENDING
  NOT_APPLICABLE
}

model FieldTest {
  id                  String           @id @default(cuid())
  projectId           String
  testNumber          String
  typeId              String?
  areaId              String?
  testDate            DateTime
  testedByName        String
  testedById          String?
  witnessedByName     String?
  responsibleOrgId    String?
  requirement         String?
  actualResult        String?
  unit                String?
  resultStatus        FieldTestResult  @default(PENDING)
  certificateReference String?
  notes               String?
  previousTestId      String?          @unique
  createdById         String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            FieldLookup?  @relation(fields: [typeId], references: [id])
  area            FieldArea?    @relation(fields: [areaId], references: [id])
  testedBy        User?         @relation("FieldTestTestedBy", fields: [testedById], references: [id])
  responsibleOrg  Organization? @relation(fields: [responsibleOrgId], references: [id])
  createdBy       User          @relation("FieldTestCreatedBy", fields: [createdById], references: [id])
  previousTest    FieldTest?    @relation("FieldTestRetestChain", fields: [previousTestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  retest          FieldTest?    @relation("FieldTestRetestChain")

  @@unique([projectId, testNumber])
  @@index([projectId, resultStatus])
  @@index([areaId])
}

// ---------------------------------------------------------------------------
// Public marketing site — unauthenticated contact/enquiry submissions.
// Deliberately outside the RBAC/project model: these come from anonymous
// visitors on the public website, not application users.
// ---------------------------------------------------------------------------

enum ContactEnquiryType {
  GENERAL
  PROJECT
  INTERIOR_DESIGN
  FURNITURE
  FIT_OUT
  EXHIBITION
  DIGITAL_PLATFORM
  HSE_SAFETY
  QUALITY_COMPLIANCE
}

model ContactEnquiry {
  id             String             @id @default(cuid())
  name           String
  company        String?
  email          String
  enquiryType    ContactEnquiryType
  projectArea    String?
  message        String
  attachmentPath String?
  createdAt      DateTime           @default(now())

  @@index([createdAt])
}
