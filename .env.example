# Copy this file to .env and fill in real values. Never commit .env itself
# (already excluded by .gitignore). Every variable below is actually read by
# the application or its tooling — none of this is aspirational.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string, read by Prisma (prisma/schema.prisma's
# datasource block) and by prisma.config.ts for migrations/seeding. This is
# the ONLY environment variable the running application itself requires.
#
# Production: replace with your real managed-Postgres connection string —
# never reuse the local value below outside this repo's own Docker Compose
# setup:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
#
# Local development default (matches docker-compose.yml's own committed,
# non-secret local-only Postgres container — this password has no value or
# reach outside a container on your own machine, and is intentionally the
# same value already in docker-compose.yml so the two stay in sync):
DATABASE_URL="postgresql://shanfari:shanfari_dev_password@localhost:5434/shanfari_edms?schema=public"

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# Set automatically by the `dev`/`build`/`start` npm scripts (via Next.js) —
# you do not need to set this by hand. Documented here only because the app
# reads it directly in two places: session cookies are marked `Secure` only
# when NODE_ENV=production (src/lib/auth/session.ts), and the
# Strict-Transport-Security response header is only sent in production
# (next.config.ts).
# NODE_ENV=development

# -----------------------------------------------------------------------------
# File storage (optional — defaults to local disk)
# -----------------------------------------------------------------------------
# STORAGE_DRIVER selects the backend (src/lib/storage/index.ts). Leave unset
# (or "local") for local-disk storage under ./storage — what every QA pass
# and the dev environment actually use today. Set to "s3" to use any
# S3-compatible object store (AWS S3, Cloudflare R2, MinIO, ...) instead —
# code-complete and unit-tested against a mocked client
# (src/lib/storage/s3-driver.test.ts), but NOT exercised against a real
# bucket by this repository (no cloud account is provisioned here).
# STORAGE_DRIVER=local

# Required only when STORAGE_DRIVER=s3:
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required only for non-AWS S3-compatible providers (e.g. MinIO, R2):
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Disposable test / QA database (not a separate env var — same DATABASE_URL)
# -----------------------------------------------------------------------------
# For any destructive or lifecycle testing (see docs/TESTING.md), point this
# SAME variable at a separate, disposable database instead of the real one,
# e.g. in your shell for a single command:
#   DATABASE_URL="postgresql://shanfari:shanfari_dev_password@localhost:5434/shanfari_edms_test?schema=public" npx prisma migrate deploy
# Never run `prisma migrate reset` against the real database, and never point
# this file's DATABASE_URL at the real database while running destructive
# tests.
